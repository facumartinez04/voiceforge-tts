# === Vast.ai ===
VASTAI_API_KEY=tu_api_key_de_vastai

# === Docker Hub ===
DOCKER_USER=tu_usuario_dockerhub
DOCKER_IMAGE=voiceforge-tts

# === Cloudflare Tunnel (para dominio custom) ===
# Crear tunnel: cloudflared tunnel create voiceforge
# Obtener token: cloudflared tunnel token voiceforge
CLOUDFLARE_TUNNEL_TOKEN=tu_token_de_tunnel

# === Dominio ===
TTS_DOMAIN=tts.tudominio.com
